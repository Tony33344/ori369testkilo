# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Calendar API (Service Account)
# STEP 1: Share your Google Calendar with the service account email:
#         ori369-koledar@ori369-calendar.iam.gserviceaccount.com
#         (Permission: "Make changes to events")
# STEP 2: Set GOOGLE_CALENDAR_ID to YOUR calendar ID (find in Google Calendar Settings > Integrate calendar)
#         It looks like: your-email@gmail.com or abc123@group.calendar.google.com
#         DO NOT leave as "primary" — that points to the service account's own empty calendar!
# STEP 3: Choose ONE of these credential methods:
#
#   OPTION A (RECOMMENDED for Netlify - avoids 4KB env limit):
#     Extract client_email and private_key from ori369-calendar-96684c4cecbe.json
#     Set these two variables:
GOOGLE_SERVICE_ACCOUNT_EMAIL=ori369-koledar@ori369-calendar.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n
#
#   OPTION B (Local dev - file-based):
#     Place google-calendar-credentials.json in project root
#     Leave the above two variables empty
#
#   OPTION C (Full JSON - NOT recommended for Netlify due to size):
#     Base64-encode the JSON: base64 -w 0 ori369-calendar-96684c4cecbe.json
GOOGLE_SERVICE_ACCOUNT_KEY=
#
GOOGLE_CALENDAR_ID=your-actual-calendar-id@gmail.com

# Google Places API (for fetching reviews)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Admin emails (comma-separated)
ADMIN_EMAILS=admin@ori369.com,jernej.babij@gmail.com

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
